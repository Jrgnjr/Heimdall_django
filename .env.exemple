# Copier en `.env` et renseigner.
#
# Ce fichier sert à deux usages. Sans Docker, aucune de ces variables n'est
# nécessaire pour développer : le projet démarre sur SQLite en mode DEBUG. Avec
# Docker, `docker compose` lit ce `.env` automatiquement, et trois variables y
# deviennent obligatoires — la composition refuse de démarrer sans elles.

# ---------------------------------------------------------------------------
# Obligatoire, avec ou sans Docker
# ---------------------------------------------------------------------------

# Générer une valeur longue et aléatoire, par exemple :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Hors DEBUG, le projet refuse de démarrer sans : une clé tirée au hasard à
# chaque redémarrage invaliderait toutes les sessions et tous les jetons CSRF.
DJANGO_SECRET_KEY=

# ---------------------------------------------------------------------------
# Obligatoire avec Docker
# ---------------------------------------------------------------------------

POSTGRES_PASSWORD=
POSTGRES_USER=heimdall
POSTGRES_DB=heimdall

# Port exposé sur la machine hôte.
HEIMDALL_PORT=8750

# ---------------------------------------------------------------------------
# Adressage
# ---------------------------------------------------------------------------

DJANGO_DEBUG=0

# Les noms d'hôte sous lesquels le site est joignable. Django refuse les
# requêtes qui arrivent sous un autre nom.
DJANGO_ALLOWED_HOSTS=stock.exemple.fr

# Origines autorisées à poster (formulaires et API). Avec le schéma.
DJANGO_CSRF_TRUSTED_ORIGINS=https://stock.exemple.fr

# ---------------------------------------------------------------------------
# Base de données
# ---------------------------------------------------------------------------
#
# PostgreSQL, et lui seul : `DATABASE_URL` est **obligatoire**, le projet refuse
# de démarrer sans. SQLite a servi de repli pendant le portage et a été retiré —
# deux bases aux contenus différents sur le même poste créaient plus de
# confusion que la commodité ne valait.
#
# Avec Docker, `docker-compose.yml` fabrique lui-même la DATABASE_URL du
# conteneur (vers « base:5432 ») à partir des POSTGRES_* ci-dessus. La ligne
# ci-dessous ne sert donc qu'à travailler **hors** conteneur : tests,
# runserver, psql. Elle pointe sur la base que Compose expose sur 127.0.0.1.
#
#   docker compose up -d base     # puis les commandes locales fonctionnent
DATABASE_URL=postgres://heimdall:motdepasse@127.0.0.1:5432/heimdall

# Port exposé sur la machine hôte pour cet usage. Sur un serveur où personne ne
# développe, retirez la section `ports:` du service `base`.
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# TLS
# ---------------------------------------------------------------------------

# Le site est-il réellement servi en HTTPS ?
#
# Gouverne les cookies `Secure`, que le navigateur refuse d'envoyer sur une
# connexion en clair. C'est LA variable à corriger pour un déploiement en http://
# sur le réseau local — laissée à 1, personne ne peut se connecter : l'écran de
# connexion reboucle sans message, parce que le cookie CSRF n'arrive jamais.
#
# Le piège est invisible en essai local : les navigateurs traitent
# `http://localhost` comme un contexte sécurisé et envoient quand même les
# cookies `Secure`. C'est en déployant sur une vraie adresse que ça casse.
#
#   http://192.168.1.50:8750  -> DJANGO_HTTPS=0
#   https://stock.exemple.fr  -> DJANGO_HTTPS=1
DJANGO_HTTPS=1

# À activer si un reverse proxy termine TLS devant Django : sans cela, Django
# croit la requête en clair et génère des redirections en http.
DJANGO_DERRIERE_PROXY=1

# Redirection HTTPS et HSTS. À n'activer que lorsque le site est réellement
# joignable en HTTPS : HSTS est difficile à annuler, les navigateurs s'en
# souviennent pendant toute la durée annoncée.
DJANGO_FORCE_HTTPS=1
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_SOUS_DOMAINES=1
DJANGO_HSTS_PRELOAD=0

DJANGO_TIME_ZONE=Europe/Paris

# ---------------------------------------------------------------------------
# Premier compte
# ---------------------------------------------------------------------------
#
# Au premier démarrage, le conteneur crée un compte administrateur s'il n'en
# existe aucun. Sans mot de passe indiqué, il en tire un au hasard et l'affiche
# **une seule fois** dans les journaux (`docker compose logs web`), avec
# obligation de le remplacer à la première connexion.
HEIMDALL_AMORCER_ADMIN=1
HEIMDALL_ADMIN_IDENTIFIANT=Admin
# HEIMDALL_ADMIN_MOTDEPASSE=

# Secondes d'attente de la base au démarrage avant d'abandonner.
HEIMDALL_ATTENTE_BASE=60
